package com.JOSE.Inventario.Controller;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.security.access.prepost.PreAuthorize;
import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;
import org.springframework.ui.Model;

import com.JOSE.Inventario.DTO.PedidoRequesDteo;
import com.JOSE.Inventario.DTO.PedidoResponseDto;
import com.JOSE.Inventario.Service.IPedidoService;


@RestController
@RequestMapping("/api/pedidos")
@PreAuthorize("denyAll()")
public class PedidoController {

    @Autowired
    private IPedidoService pedidoService;

    @PreAuthorize("hasRole('ADMIN')")
    @GetMapping
    public String  getAllPedidos(Model model) {
    	List<PedidoResponseDto> pedidos= pedidoService.listaPedido();
    	model.addAttribute("pedidos",pedidos);
    	
    	
        return "pedidos";
    }
    
    
    
    
    // Obtener todos los pedidos de un usuario por su ID
    @PreAuthorize("hasAuthority('READ')")
    @GetMapping("/usuario/{id}")
    public ResponseEntity<List<PedidoResponseDto>> obtenerPedidosPorUsuario(@PathVariable Long id) {
        List<PedidoResponseDto> pedidos = pedidoService.listaPedidoIdUsuario(id);
        
        if (pedidos.isEmpty()) {
            return ResponseEntity.noContent().build(); // 204 No Content si no hay pedidos
        }

        return ResponseEntity.ok(pedidos); // 200 OK con la lista de pedidos
    }


    @PreAuthorize("hasAuthority('READ')")
    @GetMapping("/{id}")
    public ResponseEntity<?> getPedidoById(@PathVariable Long id) {
        try {
            PedidoResponseDto pedido = pedidoService.buscarPedidoid(id)
                .orElseThrow(() -> new RuntimeException("Pedido no encontrado"));
            return ResponseEntity.ok(pedido);
        } catch (RuntimeException e) {
            return ResponseEntity.status(HttpStatus.NOT_FOUND).body("Pedido no encontrado");
        }
    }

    @PreAuthorize("hasRole('ADMIN')")
    @PostMapping
    public ResponseEntity<?> createPedido(@RequestBody PedidoRequesDteo pedidoDto) {
        try {
            System.out.println("Recibiendo pedido: " + pedidoDto);
            System.out.println("ID Usuario: " + pedidoDto.getIdUsuario());
            System.out.println("Total: " + pedidoDto.getTotal());
            System.out.println("Detalles: " + pedidoDto.getDetalles());
            
            PedidoResponseDto newPedido = pedidoService.guardarPedido(pedidoDto);
            return ResponseEntity.status(HttpStatus.CREATED).body(newPedido);
        } catch (RuntimeException e) {
            System.err.println("Error al crear pedido: " + e.getMessage());
            e.printStackTrace();
            return ResponseEntity.badRequest().body("Error al crear el pedido: " + e.getMessage());
        }
    }
    
   
    @PreAuthorize("hasRole('USER')")
   
    @PostMapping("/user/pedido")
    public ResponseEntity<?> createPedidoUser(@RequestBody PedidoRequesDteo pedidoDto) {
        try {
         
            PedidoResponseDto newPedido = pedidoService.guardarPedido(pedidoDto);
            return ResponseEntity.status(HttpStatus.CREATED).body(newPedido);
        } catch (RuntimeException e) {
            return ResponseEntity.badRequest().body("Error al crear el pedido: " + e.getMessage());
        }
    }
  

    @PreAuthorize("hasRole('ADMIN')")
    @PutMapping("/{id}")
    public ResponseEntity<?> updatePedido(@PathVariable Long id, @RequestBody PedidoRequesDteo pedidoDto) {
        try {
      

            PedidoResponseDto updatedPedido = pedidoService.actualizarPedido(id, pedidoDto);
            return ResponseEntity.ok(updatedPedido);
        } catch (RuntimeException e) {
            return ResponseEntity.status(HttpStatus.NOT_FOUND).body("Pedido no encontrado");
        }
    }

    @PreAuthorize("hasRole('ADMIN')")
    @DeleteMapping("/{id}")
    public ResponseEntity<?> deletePedido(@PathVariable Long id) {
        try {
            pedidoService.buscarPedidoid(id)
                .orElseThrow(() -> new RuntimeException("Pedido no encontrado"));
            pedidoService.eliminarPedido(id);
            return ResponseEntity.ok("Pedido eliminado correctamente");
        } catch (RuntimeException e) {
            return ResponseEntity.status(HttpStatus.NOT_FOUND).body("Pedido no encontrado");
        }
    }
}
