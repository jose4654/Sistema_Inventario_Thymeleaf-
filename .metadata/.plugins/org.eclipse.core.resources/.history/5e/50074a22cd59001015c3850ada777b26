<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org"></html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema de Inventario</title>
    <!-- Importación de Bootstrap CSS para el diseño responsive y componentes de UI -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome para los iconos de la interfaz -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <!-- Estilos personalizados para mejorar la apariencia -->
   <link rel="stylesheet" href="/css/inventario.css" />
</head>
<body>
    <!-- Barra de navegación principal -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" href="#">Sistema de Inventario</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link active" href="#">Productos</a>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link btn btn-link" onclick="mostrarListaUsuarios()">
                            <i class="fas fa-users"></i> Usuarios
                        </button>
                    </li>
                </ul>
                <!-- Botón de cerrar sesión -->
                <button class="btn btn-light" onclick="cerrarSesion()">
                    <i class="fas fa-sign-out-alt"></i> Cerrar Sesión
                </button>
            </div>
        </div>
    </nav>

    <!-- Contenedor principal de la aplicación -->
    <div class="container mt-4">
        <!-- Barra superior con título y búsqueda -->
        <div class="row mb-4">
            <div class="col">
                <h2>Lista de Productos</h2>
            </div>
            <div class="col-auto d-flex gap-2">
                <!-- Botón para agregar nuevo producto -->
                <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#agregarProductoModal">
                    <i class="fas fa-plus"></i> Agregar Producto
                </button>
                 <!-- Botón para ver pedidos -->
              <button class="btn btn-success" onclick="mostrarListaPedidos()">
    <i class="fas fa-eye"></i> Ver Pedidos</button>

                <!-- Barra de búsqueda de productos -->
                <div class="input-group">
                    <input type="text" class="form-control" id="searchInput" placeholder="Buscar productos...">
                    <button class="btn btn-outline-secondary" type="button">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </div>
        </div>

        
        

   

    <!-- Modal para agregar nuevo producto -->
    <div class="modal fade" id="agregarProductoModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Agregar Nuevo Producto</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Formulario para nuevo producto -->
                    <form id="agregarProductoForm">
                        <div class="mb-3">
                            <label for="nombre" class="form-label">Nombre</label>
                            <input type="text" class="form-control" id="nombre" required>
                        </div>
                        <div class="mb-3">
                            <label for="precio" class="form-label">Precio</label>
                            <input type="number" step="0.01" class="form-control" id="precio" required>
                        </div>
                        <div class="mb-3">
                            <label for="existencia" class="form-label">Existencia</label>
                            <input type="number" class="form-control" id="existencia" required>
                        </div>
                        <div class="mb-3">
                            <label for="imagen" class="form-label">URL de la Imagen</label>
                            <input type="url" class="form-control" id="imagen">
                        </div>
                        <div class="mb-3">
                            <label for="categoria" class="form-label">Categoría</label>
                            <select class="form-select" id="categoria" required>
                                <option value="">Seleccione una categoría</option>
                            </select>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" onclick="guardarProducto()">Guardar</button>
                </div>
            </div>
        </div>
    </div>

<!-- Modal para ver pedidos y detalle de un pedido -->
<div class="modal fade" id="verPedidosModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <!-- Encabezado del modal -->
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Listado de Pedidos</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <!-- Cuerpo del modal -->
            <div class="modal-body">
                <!-- Contenedor de lista de pedidos (se muestra inicialmente) -->
                <div id="listaPedidosContainer">
                    <table class="table table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Usuario</th>
                                <th>Estado</th>
                                <th>Fecha</th>
                                <th>Total</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="tablaPedidosModal">
                            <!-- Se llenará dinámicamente con JS -->
                        </tbody>
                    </table>
                </div>

                <!-- Contenedor de detalle del pedido (oculto inicialmente) -->
                <div id="detallePedidoContainer" style="display: none;">
                    <!-- Información general del pedido -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">ID:</label>
                        <span id="pedidoId"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Usuario:</label>
                        <span id="pedidoUsuario"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Estado:</label>
                        <span id="pedidoEstado"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Fecha:</label>
                        <span id="pedidoFecha"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Total:</label>
                        <span id="pedidoTotal"></span>
                    </div>

                    <!-- Botón para mostrar/ocultar detalles del pedido -->
                    <div class="mb-3">
                        <button class="btn btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#detallePedidoCollapse">
                            Ver Detalles del Pedido
                        </button>
                    </div>

                    <!-- Lista de detalles del pedido -->
                    <div class="collapse" id="detallePedidoCollapse">
                        <div class="table-responsive">
                            <table class="table table-bordered">
                                <thead class="table-light">
                                    <tr>
                                        <th>ID Detalle</th>
                                        <th>Producto</th>
                                        <th>Cantidad</th>
                                        <th>Precio Unitario</th>
                                        <th>Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody id="tablaDetallesPedido">
                                    <!-- Se llenará dinámicamente con JS -->
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Botón para volver a la lista de pedidos -->
                    <button class="btn btn-secondary mt-3" onclick="volverALista()">Volver a la Lista</button>
                </div>
            </div>
            <!-- Pie del modal -->
            <div class="modal-footer">
               <button type="button" class="btn btn-secondary" onclick="cerrarModalPedidos()">Cerrar</button>

            </div>
        </div>
    </div>
</div>





    <!-- Modal para editar producto existente -->
    <div class="modal fade" id="editarProductoModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Editar Producto</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Formulario para editar producto -->
                    <form id="editarProductoForm">
                        <input type="hidden" id="editId">
                        <div class="mb-3">
                            <label for="editNombre" class="form-label">Nombre</label>
                            <input type="text" class="form-control" id="editNombre" required>
                        </div>
                        <div class="mb-3">
                            <label for="editPrecio" class="form-label">Precio</label>
                            <input type="number" step="0.01" class="form-control" id="editPrecio" required>
                        </div>
                        <div class="mb-3">
                            <label for="editExistencia" class="form-label">Existencia</label>
                            <input type="number" class="form-control" id="editExistencia" required>
                        </div>
                        <div class="mb-3">
                            <label for="editImagen" class="form-label">URL de la Imagen</label>
                            <input type="url" class="form-control" id="editImagen">
                        </div>
                        <div class="mb-3">
                            <label for="editCategoria" class="form-label">Categoría</label>
                            <select class="form-select" id="editCategoria" required>
                                <option value="">Seleccione una categoría</option>
                            </select>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" onclick="actualizarProducto()">Guardar Cambios</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal para ver usuarios -->
    <div class="modal fade" id="verUsuariosModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Lista de Usuarios</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>ID</th>
                                    <th>Nombre de Usuario</th>
                                    <th>Estado</th>
                                    <th>Roles</th>
                                    <th>Cuenta Activa</th>
                                    <th>Cuenta No Bloqueada</th>
                                    <th>Credenciales Válidas</th>
                                </tr>
                            </thead>
                            <tbody id="tablaUsuarios">
                                <!-- Se llenará dinámicamente con JavaScript -->
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Importación de Bootstrap JS para la funcionalidad de los componentes -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  

</body>
</html>