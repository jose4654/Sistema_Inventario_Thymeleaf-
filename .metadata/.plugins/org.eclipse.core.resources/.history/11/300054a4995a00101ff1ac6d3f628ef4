<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org" lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema de Inventario</title>
    <!-- Importación de Bootstrap CSS para el diseño responsive y componentes de UI -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome para los iconos de la interfaz -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <!-- Estilos personalizados para mejorar la apariencia -->
   <link rel="stylesheet" href="/css/inventario.css" />
</head>
<body>
   <div th:replace="Fragmentos :: Barra"></div>

    <!-- Contenedor principal de la aplicación -->
    <div class="container mt-4">
        <!-- Barra superior con título y búsqueda -->
        <div class="row mb-4">
            <div class="col">
                <h2>Lista de Productos</h2>
            </div>
            <div class="col-auto d-flex gap-2">
                <!-- Botón para agregar nuevo producto -->
               <button class="btn btn-success" onclick="window.location.href='/productos/nuevo'">
    <i class="fas fa-plus"></i> Agregar Producto
</button>
                 <!-- Botón para ver pedidos -->
              <button class="btn btn-success" onclick="mostrarListaPedidos()">
    <i class="fas fa-eye"></i> Ver Pedidos</button>

                <!-- Barra de búsqueda de productos -->
                <div class="input-group">
                    <input type="text" class="form-control" id="searchInput" placeholder="Buscar productos...">
                    <button class="btn btn-outline-secondary" type="button">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Grid donde se muestran las tarjetas de productos -->
        <div class="row" id="productosContainer">
            <!-- Tabla de productos -->
            <div class="col-12">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Precio</th>
                            <th>Existencia</th>
                            <th>Categoría</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr th:each="producto : ${productos}">
                            <td th:text="${producto.id}">ID</td>
                            <td th:text="${producto.nombre}">Nombre</td>
                            <td th:text="${'$' + producto.precio}">Precio</td>
                            <td th:text="${producto.existencia}">Existencia</td>
                            <td th:text="${producto.categoria != null ? producto.categoria.nombre : 'Sin categoría'}">Categoría</td>
                            <td>
                               <a th:href="@{/productos/editar/{id}(id=${producto.id})}" class="btn btn-sm btn-primary">
                                             <i class="fas fa-edit"></i></a>
                               
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
   




    <!-- Importación de Bootstrap JS para la funcionalidad de los componentes -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  

</body>
</html> 