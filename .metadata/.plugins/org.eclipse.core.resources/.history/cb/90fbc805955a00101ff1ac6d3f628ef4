package com.JOSE.Inventario.Controller;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.security.access.prepost.PreAuthorize;
import org.springframework.stereotype.Controller;
import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.ModelAttribute;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.JOSE.Inventario.DTO.ProductoRequestDto;
import com.JOSE.Inventario.DTO.ProductoResponseDto;
import com.JOSE.Inventario.Model.Producto;
import com.JOSE.Inventario.Service.IProductoService;
import org.springframework.ui.Model;



@Controller
@RequestMapping("/productos")
public class ProductoController {

    @Autowired
    private IProductoService productoService;

    // ADMIN: listar todos y mostrar en una vista HTML
    @PreAuthorize("hasRole('ADMIN')")
    @GetMapping
    public String getAllProductos(Model model) {
        List<ProductoResponseDto> productos = productoService.listaProductos();
        model.addAttribute("productos", productos);
        return "sistema"; // vista sistema.html
    }

    // Público: mostrar productos sin login
    @PreAuthorize("permitAll()")
    @GetMapping("/publico")
    public String getProductosPublico(Model model) {
        List<ProductoResponseDto> productos = productoService.listaProductos();
        model.addAttribute("productos", productos);               // 👈 para mostrar productos
       
        return "sistema"; // vissta sistema.html
    }

    // Formulario para crear producto - GET muestra formulario
    @PreAuthorize("hasRole('ADMIN')")
    @GetMapping("/nuevo")
    public String mostrarFormularioNuevoProducto(Model model) {
        model.addAttribute("productoDto", new ProductoRequestDto());
        return "guardar_producto"; // formulario guardar_producto.html
    }

    // Guardar producto - POST desde formulario
    @PreAuthorize("hasRole('ADMIN')")
    @PostMapping("/guardar")
    public String createProducto(@ModelAttribute("productoDto") ProductoRequestDto productoDto, Model model) {
        try {
            productoService.guardarProducto(productoDto);
            return "redirect:/productos/publico"; // redirigir a lista
            
        } catch (RuntimeException e) {
            model.addAttribute("error", "Error al crear el producto: " + e.getMessage());
            return "guardar_producto"; // volver al formulario con error
        }
    }

    // Mostrar formulario para editar producto - GET
    @PreAuthorize("permitAll()")
    @GetMapping("/editar/{id}")
    public String mostrarFormularioEditar(@PathVariable Long id, Model model) {
        try {
            ProductoResponseDto producto = productoService.buscarProductoId(id);
            // Convertir ProductoResponseDto a ProductoRequestDto para el formulario
            ProductoRequestDto productoDto = convertirARequestDto(producto);
            model.addAttribute("productoDto", productoDto);
            return "editar_producto"; // Usar el formulario específico para editar
        } catch (RuntimeException e) {
            return "redirect:/productos/publico?error=ProductoNoEncontrado";
        }
    }

    // Actualizar producto - POST desde formulario
    @PreAuthorize("hasRole('ADMIN')")
    @PostMapping("/actualizar/{id}")
    public String updateProducto(@PathVariable Long id, @ModelAttribute("productoDto") ProductoRequestDto productoDto, Model model) {
        try {
            productoService.actualizarProducto(id, productoDto);
            return "redirect:/productos/publico";
        } catch (RuntimeException e) {
            model.addAttribute("error", "Error al actualizar el producto");
            return "editar_producto";
        }
    }

    // Eliminar producto
    @PreAuthorize("hasRole('ADMIN')")
    @GetMapping("/eliminar/{id}")
    public String deleteProducto(@PathVariable Long id) {
        try {
            productoService.eliminarProductoPorId(id);
            return "redirect:/productos/publico";
        } catch (RuntimeException e) {
            return "redirect:/productos/publico?error=ProductoNoEncontrado";
        }
    }

    // Método auxiliar para convertir ResponseDto a RequestDto
    private ProductoRequestDto convertirARequestDto(ProductoResponseDto responseDto) {
        ProductoRequestDto dto = new ProductoRequestDto();
        dto.setNombre(responseDto.getNombre());
        dto.setPrecio(responseDto.getPrecio());
        dto.setExistencia(responseDto.getExistencia());
        dto.setImagen(responseDto.getImagen());
        dto.setEstado(responseDto.isEstado());
        dto.setCategoriaId(responseDto.getCategoria().getId());
        return dto;
    }
}
